# Server Configuration
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Security
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=12h

# Initial Super Admin (only used on first database initialization)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMeNow123!
ADMIN_DISPLAY_NAME=YKSG NB-3 Super Admin

# Persistent Data Directory (outside git-tracked build artifacts on Hostinger)
DATA_DIR=./data

# Automatic Backup Interval in minutes (default 60)
BACKUP_INTERVAL_MINUTES=60
BACKUP_RETENTION_COUNT=24
